PORT=10000
NODE_ENV=development

# PostgreSQL；本地临时测试可用 DB_MODE=memory 并留空 DATABASE_URL。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_MODE=postgres
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
MAX_JSON_MB=30
AI_TIMEOUT_MS=300000

# 固定家庭账号（Render 中配置真实邮箱与密码）。
FAMILY_STUDENT_EMAIL=
FAMILY_STUDENT_PASSWORD=
FAMILY_PARENT_EMAIL=
FAMILY_PARENT_PASSWORD=

# Qwen：图片、试卷、OCR 与知识库抽取。
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_VISION_MODEL=qwen3.7-plus
QWEN_TEXT_MODEL=qwen3.7-plus

# DeepSeek：文本讲解、计划、模拟题和学生分析。
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high

# Cloudflare R2 私有资料桶。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aixuexi
R2_ENDPOINT_HOST=
R2_PRESIGN_SECONDS=900
MATERIAL_MAX_ZIP_MB=500
