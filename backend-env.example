# Render backend
NODE_ENV=production
PORT=10000
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=https://aixuexi-29x.pages.dev,https://aixuexi-parent.pages.dev
MAX_JSON_MB=35

# Fixed family student account
FAMILY_STUDENT_EMAIL=学生登录邮箱

# Optional one-time account bootstrap. Leave empty when the accounts already exist.
PRIVATE_STUDENT_EMAIL=
PRIVATE_STUDENT_PASSWORD=
PRIVATE_STUDENT_NAME=同学
PRIVATE_PARENT_EMAIL=
PRIVATE_PARENT_PASSWORD=
PRIVATE_PARENT_NAME=家长

# Cloudflare R2
# Preferred variable names
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_HOST=

# Existing names are also supported; keep these if they are already in Render.
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_PRESIGN_SECONDS=900
MATERIAL_MAX_ZIP_MB=100

# Alibaba Cloud Model Studio / Qwen
# For newer workspace-specific endpoints, replace this value with your actual workspace URL.
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_VISION_MODEL=qwen3.7-plus
QWEN_TEXT_MODEL=qwen3.7-plus
AI_TIMEOUT_MS=180000

# Optional: student-data analysis prefers DeepSeek when configured, otherwise Qwen.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
